# Crewdeck binds to this exact loopback address. Non-loopback values are refused.
CREWDECK_HOST=127.0.0.1
CREWDECK_PORT=4317

# Synthetic, no-private-data mode. Set to 0 to read the configured Firstmate home.
CREWDECK_DEMO=1

# Required in live mode. No fallback process discovery is performed.
# FM_HOME=/absolute/path/to/your/firstmate/home

# Optional trusted local executable paths.
# CREWDECK_FLEET_COMMAND=/absolute/path/to/firstmate/bin/fm-fleet-snapshot.sh
# CREWDECK_QUOTA_COMMAND=/absolute/path/to/quota-axi

# Optional alias registry location. Defaults to FM_HOME/state/crewdeck/accounts.json.
# CREWDECK_ACCOUNTS_FILE=/absolute/path/to/accounts.json
